# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user id whitelist; empty = allow everyone
TELEGRAM_BOT_ALLOWED_IDS=
# jcode session working directory
WORKING_DIR=/home/user
# Per-turn timeout (ms)
TURN_TIMEOUT_MS=600000
# Disable link previews in replies (true/false)
DISABLE_LINK_PREVIEWS=false
# Max turns queued per chat (running + pending)
QUEUE_LIMIT=5

# React 👀/✅/❌ to messages while processing (true/false)
ENABLE_REACTIONS=false
