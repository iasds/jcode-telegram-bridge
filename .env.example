# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user id whitelist; empty = allow everyone
TELEGRAM_BOT_ALLOWED_IDS=
# jcode session working directory
WORKING_DIR=/home/user
# Per-turn timeout (ms)
TURN_TIMEOUT_MS=600000
# Disable link previews in replies (true/false)
DISABLE_LINK_PREVIEWS=false
# Max turns queued per chat (running + pending)
QUEUE_LIMIT=5

# React 👀/✅/❌ to messages while processing (true/false)
ENABLE_REACTIONS=false

# Only respond in private chats; ignore groups/channels (true/false)
TELEGRAM_CHAT_ONLY=false

# --- Voice STT (hermes parity: transcribe voice/audio via faster-whisper) ---
# Enable voice -> text (true/false, default true)
STT_ENABLED=true
# STT provider: "" (auto: local>groq>openai), or local/groq/openai
STT_PROVIDER=
# Language hint for STT (default zh per local use, hermes default en)
STT_LANGUAGE=zh
# Local faster-whisper model (default small, also tiny/base/medium/large-v3)
STT_LOCAL_MODEL=small
# Echo transcript back as 🎙️ "text" before feeding agent (true/false, default true)
STT_ECHO_TRANSCRIPTS=true
# Cloud fallback keys (one is enough when local unavailable)
# GROQ_API_KEY=
# VOICE_TOOLS_OPENAI_KEY=  # or OPENAI_API_KEY

