[Unit]
Description=jcode Telegram bridge (official TS SDK)
After=jcode-api-bridge.service
Wants=jcode-api-bridge.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
WorkingDirectory=/home/user/jcode-telegram-bridge
ExecStart=/usr/bin/node dist/bridge.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
